# =============================================================================
# Google Cloud Platform & MCP Deployment Configuration
# =============================================================================
# Copy this file to .env.gcp and fill in your actual values.
# IMPORTANT: .env.gcp is git-ignored and MUST NEVER be committed to Git!

# 1. Google Cloud Project & Service Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1
GCP_SERVICE_NAME=homeassistant-jira

# 2. Authorized Family Gmail Accounts (Comma-separated, NO spaces)
# Only these specific accounts will be allowed to log into the web dashboard
# or interact with the MCP server from Gemini on Web.
ALLOWED_EMAILS=user1@gmail.com,user2@gmail.com,user3@gmail.com,user4@gmail.com

# 3. Google OAuth 2.0 Web Client Credentials
# Create these in GCP Console: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# Application type: Web application
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# 4. Jira Cloud Credentials
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-jira-account@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_BOARD_ID=engineering-1

# 5. Optional Gemini Image Generation API Key (for storybook task pictures)
GEMINI_API_KEY=

# 6. Session Signing Secret (optional - auto-generated if left empty)
SESSION_SECRET_KEY=
