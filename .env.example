# =============================================================================
# Home Assistant Jira Dashboard - Environment Variables Template
# =============================================================================

# Jira Cloud / Data Center Instance URL (e.g. https://your-domain.atlassian.net)
JIRA_URL=https://your-domain.atlassian.net

# Jira Cloud Authentication (Email + API Token)
# Generate API Token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=user@example.com
JIRA_API_TOKEN=your-jira-api-token-here

# Target Jira Board ID (defaults to primary board if empty)
JIRA_BOARD_ID=engineering-1

# Background Polling Interval in seconds (default: 60, set to 0 to disable)
POLLING_INTERVAL_SECONDS=60

# Jira Webhook Secret for HMAC SHA-256 Signature Validation (optional)
# JIRA_WEBHOOK_SECRET=your-webhook-secret

# Google GenAI / Gemini AI Task Background Illustrations (optional)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-image
# GEMINI_PROMPT_TEMPLATE="A simple, colorful, kid-friendly storybook illustration depicting the chore or activity: '{summary}'."
GEMINI_DAILY_LIMIT=100
GEMINI_DEBOUNCE_SECONDS=300
GEMINI_CACHE_RETENTION_SECONDS=2592000

# Application HTTP Port (default: 8000)
PORT=8000
