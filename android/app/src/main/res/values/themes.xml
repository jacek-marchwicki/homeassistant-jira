<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TestAppIntegrator" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.TestAppIntegrator.Light" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.TestAppIntegrator.Dark" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:isLightTheme">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
